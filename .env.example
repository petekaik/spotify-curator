# Spotify Web API credentials
# Create an app: https://developer.spotify.com/dashboard
# The redirect URI must match one registered on that app exactly.
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:43827/spotify/callback

# Last.fm API key (required for discovery): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: where profile, caches and token live (default ~/.spotify-curator)
# SPOTIFY_CURATOR_HOME=
